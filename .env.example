# Local development credentials only. Copy to .env before starting Astro.
MONGO_ROOT_USERNAME=etl_admin
MONGO_ROOT_PASSWORD=local_etl_password
MONGO_URI=mongodb://etl_admin:local_etl_password@mongodb:27017/?authSource=admin
MONGO_DATABASE=currency_exchange
MONGO_COLLECTION=exchange_rates
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=local_admin_password
BASE_CURRENCY=EUR
TARGET_CURRENCIES=USD,GBP,JPY
